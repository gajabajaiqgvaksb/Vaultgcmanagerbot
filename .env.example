# Required: token from @BotFather
BOT_TOKEN=

# "webhook" for Render / production, "polling" for local development only
MODE=polling

# Webhook mode only: public https URL of this service, and a random secret
# (letters, digits, _ or -). Generate one with: openssl rand -hex 24
PUBLIC_URL=
WEBHOOK_SECRET=

# Set automatically by Render. Locally, set it only if you want the HTTP server.
PORT=

# Super admin Telegram user IDs (comma-separated). Only they can activate groups
# and set them up (panel, admin commands) for now. Subscriptions come later.
OWNER_IDS=

# Optional: SQLite file location (default data/bot.sqlite)
DB_PATH=data/bot.sqlite

# Optional: long-poll timeout in seconds (polling mode, default 30)
POLL_TIMEOUT_SEC=30
