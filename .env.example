# Required: token from @BotFather
BOT_TOKEN=

# Optional: comma-separated Telegram user IDs with owner access (/owner panel,
# admin rights in every group)
OWNER_IDS=

# Optional: SQLite file location (default data/bot.sqlite)
DB_PATH=data/bot.sqlite

# Optional: long-poll timeout in seconds (default 30)
POLL_TIMEOUT_SEC=30
